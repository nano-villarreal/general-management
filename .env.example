# ── Core ──────────────────────────────────────────────────────────────────
PORT=3000
MONGO_LINK=mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_DB_NAME=camera_reports
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too

# ── Camera watcher ────────────────────────────────────────────────────────
ENABLE_CAMERAS=true
ANTHROPIC_API_KEY=
IDLE_THRESHOLD_MIN=15

# JSON array. Two shapes per camera — see docs/camera-relay.md:
#   direct RTSP (needs a real public IP + port-forward):
#     {"name":"Front Desk","zone":"Lobby","rtspUrl":"rtsp://user:pass@host:port/stream1"}
#   relay-based (works behind CGNAT / no port-forward — the common case):
#     {"name":"Front Desk","zone":"Lobby","relay":true}
CAMERAS_CONFIG=[]

# Shared secret between this server and any relay device(s). Required if any
# camera above uses "relay": true.
CAMERA_RELAY_SECRET=

# Only needed if you use GET /api/camera-relay/script to generate a relay's
# pre-filled setup script (see docs/camera-relay.md) — the camera's own LAN
# RTSP URL, as reachable from wherever the relay device sits.
CAMERA_RELAY_RTSP_URL=

# Business hours the watcher runs in — outside this window, no frame is
# grabbed and no API call is made. Defaults shown; adjust for your location.
BUSINESS_HOURS_TZ=America/Mexico_City
BUSINESS_HOURS_START=07:45
BUSINESS_HOURS_END=18:00

# Escape hatch — not normally needed, ffmpeg-static bundles a static binary.
# FFMPEG_PATH=
